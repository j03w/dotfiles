[core]
  pager = delta
[interactive]
  diffFilter = delta --color-only
[delta]
  navigate = true
  line-numbers = true
[color]
  ui = always
  branch = true
  diff = true
  pager = true
  status = true
[alias]
  b    = branch
  g    = grep --break --heading --line-number --ignore-case -I -C 3
  st   = status -sb
  ss   = stash
  sa   = stash apply
  sl   = stash list
  sd   = stash drop
  mt   = mergetool
  co   = checkout
  cm   = commit -m
  ca   = commit --amend
  d    = diff --color-words --ignore-space-at-eol -b -w --ignore-blank-lines
  lg   = log --color --graph --pretty=format:'%Cred%h%Creset ·%C(yellow)%d%Creset %s %Cgreen(%cr)%Creset · %C(bold blue)%an%Creset' --abbrev-commit --
  lola = log --graph --decorate --pretty=oneline --abbrev-commit --all
  po   = push -u origin HEAD --tags
  pr   = pull --rebase
  rs   = reset --soft
  rh   = reset --hard
  rc   = rebase --continue
  ra   = rebase --abort
  sw   = switch
[grep]
  lineNumber = true
  extendRegexp = true
[core]
  excludesfile = ~/.gitignore_global
[merge]
  conflictStyle = zdiff3
[push]
  default = matching
[user]
  name = Joe Wongchanglor
  email = joe.wongchanglor@v2.ai
[mergetool "vscode"]
  cmd = code --wait $MERGED
[init]
  defaultBranch = main
[filter "lfs"]
  clean = git-lfs clean -- %f
  smudge = git-lfs smudge -- %f
  process = git-lfs filter-process
  required = true
